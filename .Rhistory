# MKTG 411: Codex introduction
# Hillstrom email experiment: one row per assigned customer.
# Download hillstrom-practice.zip from Canvas and extract to codex-practice.
# Keep the CSV, this script, and the notes together in that folder.
# Use codex-practice as the R working directory.
# Read hillstrom-data-notes.md for the study and column definitions.
# If needed, install tidyverse once with install.packages("tidyverse").
# Save this file before asking Codex to change it, then reload it afterward.
library(tidyverse)
hillstrom <- read_csv("hillstrom.csv", show_col_types = FALSE)
average_spend <- hillstrom |>
group_by(segment) |>
summarise(average_spend = mean(spend), .groups = "drop")
ggplot(average_spend, aes(x = segment, y = average_spend, fill = segment)) +
geom_col(show.legend = FALSE) +
labs(
title = "Average Campaign Spend by Email Group",
x = "Campaign assignment",
y = "Average spend ($)"
) +
theme_minimal()
library(tidyverse)
hillstrom <- read_csv("hillstrom.csv", show_col_types = FALSE)
campaign_performance <- hillstrom %>%
group_by(segment) %>%
summarise(
customers = n(),
visits = sum(visit),
purchases = sum(conversion),
visit_rate = mean(visit),
conversion_rate = mean(conversion),
average_spend = mean(spend),
total_spend = sum(spend),
.groups = "drop"
) %>%
mutate(
visit_rate = scales::percent(visit_rate, accuracy = 0.1),
conversion_rate = scales::percent(conversion_rate, accuracy = 0.1),
average_spend = scales::dollar(average_spend, accuracy = 0.01),
total_spend = scales::dollar(total_spend, accuracy = 1)
) %>%
arrange(desc(total_spend))
campaign_performance
library(tidyverse)
hillstrom <- read_csv("hillstrom.csv", show_col_types = FALSE)
average_spend <- hillstrom %>%
filter(segment %in% c("Mens E-Mail", "Womens E-Mail"), conversion == 1) %>%
group_by(segment) %>%
summarize(average_spend = mean(spend), .groups = "drop")
ggplot(average_spend, aes(x = segment, y = average_spend, fill = segment)) +
geom_col(show.legend = FALSE) +
labs(
title = "Average Spend Among Customers Who Purchased",
x = "Email campaign",
y = "Average spend ($)"
) +
theme_minimal()
library(tidyverse)
hillstrom <- read_csv("hillstrom.csv", show_col_types = FALSE)
campaign_summary <- hillstrom %>%
group_by(segment) %>%
summarize(
customer_count = n(),
purchase_rate = mean(conversion),
revenue_per_targeted_customer = mean(spend),
.groups = "drop"
) %>%
mutate(
purchase_rate = round(purchase_rate * 100, 1),
revenue_per_targeted_customer = round(revenue_per_targeted_customer, 2)
)
knitr::kable(
campaign_summary,
col.names = c(
"Campaign group",
"Customer count",
"Purchase rate (%)",
"Revenue per targeted customer ($)"
),
align = c("l", "r", "r", "r")
)
ggplot(campaign_summary, aes(x = segment, y = revenue_per_targeted_customer, fill = segment)) +
geom_col(show.legend = FALSE) +
labs(
title = "Revenue per Assigned Customer by Campaign Group",
x = "Campaign group",
y = "Revenue per assigned customer ($)"
) +
theme_minimal()
library(tidyverse)
hillstrom <- read_csv("hillstrom.csv", show_col_types = FALSE)
campaign_summary <- hillstrom %>%
mutate(segment = fct_relevel(segment, "No E-Mail")) %>%
group_by(segment) %>%
summarize(
customer_count = n(),
purchase_rate = mean(conversion),
revenue_per_targeted_customer = mean(spend),
.groups = "drop"
) %>%
mutate(
purchase_rate = round(purchase_rate * 100, 1),
revenue_per_targeted_customer = round(revenue_per_targeted_customer, 2)
)
campaign_summary
ggplot(campaign_summary, aes(x = segment, y = revenue_per_targeted_customer, fill = segment)) +
geom_col(show.legend = FALSE) +
geom_text(
aes(label = if_else(segment == "No E-Mail", "Baseline", "")),
vjust = -0.5,
show.legend = FALSE
) +
labs(
title = "Revenue per Assigned Customer by Campaign Group",
subtitle = "Based on two weeks of post-campaign purchase data",
x = "Campaign group",
y = "Revenue per assigned customer ($)"
) +
theme_minimal()
library(tidyverse)
hillstrom <- read_csv("hillstrom.csv", show_col_types = FALSE)
stopifnot(
all(c("Mens E-Mail", "Womens E-Mail", "No E-Mail") %in% unique(hillstrom$segment)),
all(hillstrom$conversion %in% c(0, 1)),
all(hillstrom$spend >= 0)
)
campaign_summary <- hillstrom %>%
mutate(segment = fct_relevel(segment, "No E-Mail")) %>%
group_by(segment) %>%
summarise(
customer_count = n(),
purchase_rate = mean(conversion),
revenue_per_targeted_customer = mean(spend),
.groups = "drop"
) %>%
mutate(
purchase_rate = round(purchase_rate * 100, 1),
revenue_per_targeted_customer = round(revenue_per_targeted_customer, 2)
)
campaign_summary
ggplot(campaign_summary, aes(x = segment, y = revenue_per_targeted_customer, fill = segment)) +
geom_col(show.legend = FALSE) +
geom_text(
aes(label = if_else(segment == "No E-Mail", "Baseline", "")),
vjust = -0.5,
show.legend = FALSE
) +
labs(
title = "Revenue per Assigned Customer by Campaign Group",
subtitle = "Based on two weeks of post-campaign purchase data",
x = "Campaign group",
y = "Revenue per assigned customer ($)"
) +
theme_minimal()
